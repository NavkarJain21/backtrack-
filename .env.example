# Anthropic API Key (required for live AI generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional model override (defaults to claude-sonnet-4-5)
ANTHROPIC_MODEL=claude-sonnet-4-5

# Set to true to force offline/mock mode. Leave false (or unset) to use the
# real AI generation path whenever ANTHROPIC_API_KEY is configured.
DISABLE_AI=false
